{
  "expo": {
    "name": "Soostori POS",
    "slug": "soostori-mobile",
    "scheme": "soostori",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soostori.pos",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Soostori POS needs Bluetooth to discover barcode scanners and receipt printers.",
        "NSBluetoothPeripheralUsageDescription": "Soostori POS needs Bluetooth to discover barcode scanners and receipt printers.",
        "NSLocalNetworkUsageDescription": "Soostori POS needs local network access to discover WiFi receipt printers.",
        "NSBonjourServices": ["_pdl-datastream._tcp", "_printer._tcp", "_ipp._tcp", "_scanner._tcp"]
      }
    },
    "android": {
      "package": "com.soostori.pos",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#f97316",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "newArchEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
