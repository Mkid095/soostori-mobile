{
  "expo": {
    "name": "Soostori POS",
    "slug": "soostori-mobile",
    "scheme": "soostori",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soostori.pos"
    },
    "android": {
      "package": "com.soostori.pos",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#f97316",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "newArchEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
