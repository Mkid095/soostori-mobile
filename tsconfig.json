{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "paths": {
      "@soostori/auth/permissions": ["./src/types/permissions.ts"],
      "@soostori/customers": ["./src/types/@soostori/CustomersRepository.d.ts"],
      "@soostori/sales": ["./src/types/@soostori/SalesRepository.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
